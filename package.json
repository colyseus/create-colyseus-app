{
  "name": "create-colyseus-app",
  "version": "0.18.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "main": "index.js",
  "bin": {
    "create-colyseus-app": "index.js"
  },
  "engines": {
    "node": ">= 22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/colyseus/create-colyseus.git"
  },
  "keywords": [
    "colyseus",
    "multiplayer",
    "boilerplate"
  ],
  "files": [
    "lib",
    "templates",
    "index.js",
    "!templates/**/node_modules",
    "!templates/**/build",
    "!templates/**/dist",
    "!templates/**/package-lock.json",
    "!templates/**/pnpm-lock.yaml",
    "!templates/**/yarn.lock",
    "!templates/**/bun.lock*"
  ],
  "author": "Endel Dreyer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "dependencies": {
    "enquirer": "^2.3.0",
    "npm": "^10.8.2"
  },
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "test:quick": "node scripts/smoke.mjs --quick"
  }
}
